generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SavedItemType {
  NEWS
  EVENT
  JOB
  ANNOUNCEMENT
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  REJECTED
}

enum ConversationRole {
  OWNER
  MODERATOR
  MEMBER
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  phone          String?
  institution    String?
  avatarUrl      String?
  bio            String?
  organizationRole String?
  role           UserRole       @default(USER)
  status         UserStatus     @default(PENDING)
  chapterId      String?
  chapter        Chapter?       @relation(fields: [chapterId], references: [id])
  pollVotes      PollVote[]
  messages       Message[]
  conversationParticipants ConversationParticipant[]
  notifications  Notification[]
  savedItems     SavedItem[]
  refreshTokens  RefreshToken[]
  createdNews    NewsArticle[]  @relation("NewsCreator")
  createdEvents  Event[]        @relation("EventCreator")
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  createdJobs    Job[]          @relation("JobCreator")
  createdPolls   Poll[]         @relation("PollCreator")
  createdConversations Conversation[] @relation("ConversationCreator")
  jobApplications JobApplication[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Chapter {
  id          String   @id @default(cuid())
  name        String
  campus      String
  region      String?
  description String?
  logoUrl     String?
  memberEstimate Int?
  members     User[]
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsArticle {
  id          String        @id @default(cuid())
  title       String
  summary     String
  body        String
  category    String?
  imageUrl    String?
  imageUrls   String[]      @default([])
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  creatorId   String?
  creator     User?         @relation("NewsCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String
  organizer   String        @default("TESCON")
  venue       String
  venueNote   String?
  startsAt    DateTime
  endsAt      DateTime?
  feeLabel    String        @default("Free")
  chatUrl     String?
  imageUrl    String?
  imageUrls   String[]      @default([])
  status      PublishStatus @default(PUBLISHED)
  chapterId   String?
  chapter     Chapter?      @relation(fields: [chapterId], references: [id])
  creatorId   String?
  creator     User?         @relation("EventCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
  @@index([chapterId])
}

model Announcement {
  id          String        @id @default(cuid())
  title       String
  body        String
  priority    String        @default("normal")
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  creatorId   String?
  creator     User?         @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
}

model Job {
  id          String        @id @default(cuid())
  title       String
  company     String
  logoUrl     String?
  location    String
  type        String
  description String
  applyUrl    String?
  deadline    DateTime?
  status      PublishStatus @default(DRAFT)
  creatorId   String?
  creator     User?         @relation("JobCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  applications JobApplication[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
}

model JobApplication {
  id             String               @id @default(cuid())
  jobId          String
  job            Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String
  email          String
  phone          String?
  institution    String?
  coverNote      String?
  credentialsUrl String?
  supportingUrl  String?
  status         JobApplicationStatus @default(APPLIED)
  interviewAt    DateTime?
  interviewNote  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([jobId, email])
  @@index([jobId])
  @@index([userId])
  @@index([status])
}

model Poll {
  id          String        @id @default(cuid())
  question    String
  description String?
  status      PublishStatus @default(DRAFT)
  closesAt    DateTime?
  visibility  String        @default("members")
  allowMultipleVotes Boolean @default(false)
  options     PollOption[]
  votes       PollVote[]
  creatorId   String?
  creator     User?         @relation("PollCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([creatorId])
}

model PollOption {
  id      String     @id @default(cuid())
  text    String
  pollId  String
  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes   PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  isGroup   Boolean   @default(true)
  creatorId String?
  creator   User?     @relation("ConversationCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([creatorId])
}

model ConversationParticipant {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  body           String
  mediaUrl       String?
  mediaType      String?
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model SavedItem {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType  SavedItemType
  itemId    String
  createdAt DateTime      @default(now())

  @@unique([userId, itemType, itemId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}
